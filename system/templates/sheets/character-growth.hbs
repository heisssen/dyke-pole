<section class="tab ws-tab {{tab.cssClass}}" data-tab="growth" data-group="primary">
  <h2 class="ws-h">{{localize "WS.Sheet.Projects"}} {{#if canProject}}<a data-action="project"><i class="fa-solid fa-plus"></i></a>{{/if}}</h2>
  <ul class="ws-projects" data-list="system.projects">
    {{#each projects}}
    <li data-index="{{i}}">
      <div class="row1">
        <input type="text" name="system.projects.{{i}}.name" value="{{name}}">
        <select name="system.projects.{{i}}.kind">{{#each ../projectKinds}}<option value="{{value}}" {{#if (eq value ../kind)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
        {{#if (eq kind "skill")}}<select name="system.projects.{{i}}.target"><option value=""></option>{{#each ../skills}}<option value="{{key}}" {{#if (eq key ../target)}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
        {{#if (eq kind "knowledge")}}<select name="system.projects.{{i}}.target"><option value=""></option>{{#each ../knowledges}}<option value="{{key}}" {{#if (eq key ../target)}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
        <input type="number" class="len" name="system.projects.{{i}}.max" value="{{max}}" min="1" max="12" data-tooltip="{{localize 'WS.Project.Length'}}">
        <a data-action="removeRow"><i class="fa-solid fa-xmark"></i></a>
      </div>
      {{> "systems/dyke-pole/templates/parts/pips.hbs" pips=pips path=(concat "system.projects." i ".value") cls="project"}}
    </li>
    {{else}}<li class="empty">{{localize "WS.Project.None"}}</li>{{/each}}
  </ul>
  <p class="ws-note">{{localize "WS.Project.Rule"}}</p>

  <h2 class="ws-h">{{localize "WS.Sheet.Facts"}}</h2>
  <textarea name="system.facts" rows="4" placeholder="{{localize 'WS.Sheet.FactsHint'}}">{{system.facts}}</textarea>
</section>
